<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.chankay.wechat-relay</string>
	<key>ProgramArguments</key>
	<array>
		<string>/absolute/path/to/node</string>
		<string>--env-file=/operator/managed/wechat-relay.env</string>
		<string>/absolute/path/to/www.chankay.com/apps/wechat-relay/dist/server.js</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/absolute/path/to/www.chankay.com</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/tmp/chankay-wechat-relay.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/chankay-wechat-relay.error.log</string>
</dict>
</plist>
