{
  "extends": "@repo/typescript-config/nextjs",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "src/typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/importMap.js",
    "src/app/(payload)/importMap.js"
  ],
  "references": [{"path": "../../packages/ui"}]
}
