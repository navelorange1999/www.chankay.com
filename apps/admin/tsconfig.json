{
  "extends": "@repo/typescript-config/nextjs",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    ".next/types/**/*.ts",
    "src/app/(payload)/**/*.(ts|tsx)",
    "src/typings/**/*.d.ts"
  ],
  "exclude": ["node_modules", "src/app/(payload)/importMap.js"]
}
