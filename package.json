{
  "name": "www.navelorage1999.com",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "gen": "turbo run gen",
    "dev": "turbo dev",
    "dev:ui": "turbo run dev --filter=@repo/ui --filter=storybook",
    "dev:admin": "turbo run dev --filter=@repo/ui --filter=admin",
    "dev:www": "turbo run dev --filter=@repo/ui --filter=www",
    "dev:site-shell": "pnpm --filter @chankay/site-shell preview:dev",
    "start": "turbo start",
    "build": "turbo build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "cz": "git cz",
    "prepare": "husky",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\"",
    "clean": "turbo run clean && pnpm clean:root",
    "clean:root": "rm -rf node_modules/.cache && rm -rf .turbo",
    "clean:all": "pnpm clean && rm -rf node_modules && pnpm install"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "commitizen": "^4.3.1",
    "cz-emoji": "^1.3.2-canary.2",
    "eslint": "^9.30.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "turbo": "^2.9.16",
    "typescript": "^5.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
