{
  "name": "admin",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint --fix",
    "gen": "pnpm gen:importmap && pnpm gen:types",
    "gen:importmap": "payload generate:importmap",
    "gen:types": "payload generate:types",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "check-types": "tsc --noEmit --skipLibCheck",
    "clean": "rm -rf .next && rm -rf .turbo"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.46.0",
    "@payloadcms/next": "^3.46.0",
    "@payloadcms/plugin-seo": "3.46.0",
    "@payloadcms/richtext-lexical": "^3.46.0",
    "@payloadcms/storage-vercel-blob": "3.46.0",
    "@payloadcms/ui": "^3.46.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@vercel/queue": "^0.1.4",
    "graphql": "^16.11.0",
    "next": "^15.3.6",
    "payload": "^3.46.0",
    "react-colorful": "^5.6.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@vitest/ui": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
