# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Vercel blob storage token
VERCEL_BLOB_READ_WRITE_TOKEN=

# Vercel public base url
VERCEL_BLOB_PUBLIC_BASE_URL=

# Github Client ID
GITHUB_CLIENT_ID=

# Github Client secret
GITHUB_CLIENT_SECRET=

# Github token (used by /api/github/heatmap)
GITHUB_TOKEN=

# Browserless /screenshot endpoint, e.g. https://production-sfo.browserless.io/screenshot
PREVIEW_CAPTURE_API_URL=

# Screenshot service token
PREVIEW_CAPTURE_API_KEY=

# Shared secret for internal admin -> www calls.
# Must match apps/www/.env values. Sent via the www-internal-secret request header.
# Used for preview screenshot generation and frontend revalidation.
# Generate one with: openssl rand -hex 32
WWW_INTERNAL_SECRET=

# Public base URL of the www app when different from site-config.siteUrl
WWW_SITE_URL=http://localhost:3000
