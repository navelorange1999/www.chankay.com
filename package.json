{
  "name": "www.navelorage1999.com",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "gen": "turbo run gen",
    "dev": "turbo dev",
    "dev:ui": "turbo run dev --filter=@repo/ui --filter=storybook",
    "dev:admin": "turbo run dev --filter=@repo/ui --filter=admin",
    "start": "turbo start",
    "build": "turbo build",
    "cz": "git cz",
    "prepare": "husky",
    "lint": "turbo run lint",
    "check-types": "tsc"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "commitizen": "^4.3.1",
    "cz-emoji": "^1.3.2-canary.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "turbo": "^2.5.4",
    "eslint": "^9.30.0",
    "typescript": "^5.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
