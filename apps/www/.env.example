PAYLOAD_API_URL=http://localhost:3001/api

# 7days
PAYLOAD_REVALIDATE_TIME=604800

# Shared secret for internal admin -> www calls.
# Must match apps/admin/.env values. Sent via the www-internal-secret request header.
# Used to authorize /_preview/* screenshots and /api/revalidate.
# Generate one with: openssl rand -hex 32
WWW_INTERNAL_SECRET=

# Optional public site URL override for metadata fallbacks
WWW_SITE_URL=http://localhost:3000
