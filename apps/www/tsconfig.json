{
  "extends": "@repo/typescript-config/nextjs",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "types": ["next"],
    "paths": {
      "@repo/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src", ".next/types/**/*.ts"],
  "exclude": ["node_modules"],
  "references": [{ "path": "../../packages/ui" }]
}
