{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/queue/social-publications/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "social-publications" }],
      "maxDuration": 180
    },
    "src/app/api/queue/page-assets/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "page-assets"
        }
      ],
      "maxDuration": 60
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
