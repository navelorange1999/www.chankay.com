{
  "name": "www",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:giscus-themes && pnpm sync:brand-assets && next dev -p 3000 --turbopack",
    "build": "pnpm generate:giscus-themes && pnpm sync:brand-assets && next build",
    "start": "next start -p 3000",
    "sync:brand-assets": "node ../../packages/brand-assets/scripts/sync-assets.mjs www",
    "generate:giscus-themes": "node scripts/generate-giscus-themes.mjs",
    "check:giscus-themes": "node scripts/generate-giscus-themes.mjs --check",
    "lint": "next lint --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "pnpm check:giscus-themes && vitest run",
    "clean": "rm -rf .next && rm -rf .turbo"
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "@next/bundle-analyzer": "^16.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.539.0",
    "next": "^15.3.6",
    "nextjs-toploader": "^3.9.17",
    "@chankay/handwriting": "workspace:*"
  },
  "devDependencies": {
    "@chankay/brand-assets": "workspace:*",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "25.0.3",
    "vitest": "^3.2.4"
  }
}
